        </xs:annotation>
      </xs:element>
      <xs:element name="timeOffsetNanosecond" type="xs:long">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ ../timeOffset mod 1000 }" />
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
