  <xs:complexType name="timeMessage_t">
    <xs:sequence>
      <xs:element name="second" type="xs:unsignedInt">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element representation="binary" binaryNumberRep="binary" byteOrder="bigEndian" lengthKind="explicit" length="4" />
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="secondHour" type="xs:long">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ (xs:long((../second - (../second mod 3600)) div 3600)) mod 24 }" />
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="secondMinute" type="xs:long">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ (xs:long((../second - (../second mod 60)) div 60)) mod 60 }" />
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="secondSecond" type="xs:long">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ ../second mod 60 }" />
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="millisecond" type="xs:unsignedShort">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element representation="binary" binaryNumberRep="binary" byteOrder="bigEndian" lengthKind="explicit" length="2" />
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="systemEventMessage_t">
