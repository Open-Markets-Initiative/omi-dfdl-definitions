          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ (xs:long((../timeOffset - (../timeOffset mod 3600000000000)) div 3600000000000)) mod 24 }" />
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="timeOffsetMinute" type="xs:long">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ (xs:long((../timeOffset - (../timeOffset mod 60000000000)) div 60000000000)) mod 60 }" />
