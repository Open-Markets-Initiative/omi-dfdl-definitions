        </xs:annotation>
      </xs:element>
      <xs:element name="timeOffsetMillisecond" type="xs:long">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ (xs:long((../timeOffset - (../timeOffset mod 1000000)) div 1000000)) mod 1000 }" />
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="timeOffsetMicrosecond" type="xs:long">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ (xs:long((../timeOffset - (../timeOffset mod 1000)) div 1000)) mod 1000 }" />
