<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/" xmlns:fn="http://www.w3.org/2005/xpath-functions" xmlns:tns="urn:omi:euronext:optiq:marketdatapacket:v1" targetNamespace="urn:omi:euronext:optiq:marketdatapacket:v1">
