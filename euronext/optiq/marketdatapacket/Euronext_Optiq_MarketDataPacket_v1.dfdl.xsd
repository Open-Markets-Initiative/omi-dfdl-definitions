      </xs:element>
      <xs:element name="packetTimeHour" type="xs:long">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ (xs:long((../packetTime - (../packetTime mod 3600000000000)) div 3600000000000)) mod 24 }" />
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="packetTimeMinute" type="xs:long">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element inputValueCalc="{ (xs:long((../packetTime - (../packetTime mod 60000000000)) div 60000000000)) mod 60 }" />
