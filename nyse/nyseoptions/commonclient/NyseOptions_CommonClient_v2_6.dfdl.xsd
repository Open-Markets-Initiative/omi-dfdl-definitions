<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/" xmlns:tns="urn:omi:nyseoptions:commonclient:v2:6" targetNamespace="urn:omi:nyseoptions:commonclient:v2:6">
  <xs:annotation>
