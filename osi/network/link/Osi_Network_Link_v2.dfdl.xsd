<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/" xmlns:fn="http://www.w3.org/2005/xpath-functions" xmlns:tns="urn:omi:osi:network:link:v2" targetNamespace="urn:omi:osi:network:link:v2">
  <xs:annotation>
    <xs:appinfo source="http://www.ogf.org/dfdl/">
      <dfdl:format byteOrder="bigEndian" bitOrder="mostSignificantBitFirst" representation="binary" binaryNumberRep="binary" lengthKind="implicit" lengthUnits="bytes" encoding="ASCII" encodingErrorPolicy="replace" initiator="" terminator="" separator="" separatorPosition="infix" separatorSuppressionPolicy="anyEmpty" sequenceKind="ordered" initiatedContent="no" leadingSkip="0" trailingSkip="0" alignment="1" alignmentUnits="bytes" fillByte="%#r00;" ignoreCase="no" occursCountKind="implicit" truncateSpecifiedLengthString="no" textBidi="no" floating="no" textPadKind="none" textTrimKind="none" escapeSchemeRef="" />
    </xs:appinfo>
  </xs:annotation>
  <xs:element name="packet">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="destinationMac" type="xs:hexBinary">
          <xs:annotation>
            <xs:appinfo source="http://www.ogf.org/dfdl/">
              <dfdl:element representation="binary" lengthKind="explicit" length="6" />
            </xs:appinfo>
          </xs:annotation>
        </xs:element>
        <xs:element name="sourceMac" type="xs:hexBinary">
          <xs:annotation>
            <xs:appinfo source="http://www.ogf.org/dfdl/">
              <dfdl:element representation="binary" lengthKind="explicit" length="6" />
            </xs:appinfo>
          </xs:annotation>
        </xs:element>
        <xs:element name="etherType">
          <xs:annotation>
            <xs:appinfo source="http://www.ogf.org/dfdl/">
              <dfdl:element representation="binary" binaryNumberRep="binary" byteOrder="bigEndian" lengthKind="explicit" length="2" />
            </xs:appinfo>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:unsignedShort">
              <xs:enumeration value="2048">
                <xs:annotation>
                  <xs:documentation>Ipv4</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="2054">
                <xs:annotation>
                  <xs:documentation>Arp</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="33024">
                <xs:annotation>
                  <xs:documentation>Vlan</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="34525">
                <xs:annotation>
                  <xs:documentation>Ipv6</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="vlanTag" type="tns:vlanTag_t" minOccurs="0" maxOccurs="1">
          <xs:annotation>
            <xs:appinfo source="http://www.ogf.org/dfdl/">
              <dfdl:element occursCountKind="expression" occursCount="{ if (../etherType eq 33024) then 1 else 0 }" />
            </xs:appinfo>
          </xs:annotation>
        </xs:element>
        <xs:element name="ethernetPayload" type="xs:hexBinary">
          <xs:annotation>
            <xs:appinfo source="http://www.ogf.org/dfdl/">
              <dfdl:element lengthKind="pattern" lengthPattern="(?s).*" encoding="ISO-8859-1" />
            </xs:appinfo>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="vlanTag_t">
    <xs:sequence>
      <xs:element name="tagControl" type="tns:tagControl_t" />
      <xs:element name="innerEtherType" type="xs:unsignedShort">
        <xs:annotation>
          <xs:appinfo source="http://www.ogf.org/dfdl/">
            <dfdl:element representation="binary" binaryNumberRep="binary" byteOrder="bigEndian" lengthKind="explicit" length="2" />
